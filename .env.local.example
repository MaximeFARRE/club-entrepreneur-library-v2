# Supabase — trouvez ces valeurs dans Settings > API de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — uniquement côté serveur, ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron — secret partagé pour sécuriser l'endpoint /api/notifications
CRON_SECRET=your-random-secret

# API Google Books (Optionnel — requis si le quota public anonyme de Google est dépassé)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Brevo — pour l'envoi des emails de notification (relances de retard)
# Créer une clé sur https://app.brevo.com/settings/keys/api
# L'adresse expéditrice doit être validée dans Brevo (Senders & IP) — pas de domaine requis
BREVO_API_KEY=xkeysib-your_api_key_here
BREVO_SENDER_EMAIL=bibliotheque@club-entrepreneur.example
BREVO_SENDER_NAME=Club Entrepreneur
