# Supabase — trouvez ces valeurs dans Settings > API de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — uniquement côté serveur, ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron — secret partagé pour sécuriser l'endpoint /api/notifications
CRON_SECRET=your-random-secret

# API Google Books (Optionnel — requis si le quota public anonyme de Google est dépassé)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

